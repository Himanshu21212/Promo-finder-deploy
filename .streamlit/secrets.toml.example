# Copy this into Streamlit Community Cloud > App settings > Secrets.
# Replace the placeholder there. Never commit .streamlit/secrets.toml or a real key.
SARVAM_API_KEY = "replace-with-your-sarvam-key"

# Optional: sarvam-105b (default) or sarvam-105b-conversations.
# The app selects the correct Sarvam endpoint; users never need to edit it.
# SARVAM_MODEL = "sarvam-105b"
# V1 is the default for bounded JSON reviews with thinking disabled.
# SARVAM_BASE_URL = "https://api.sarvam.ai/v1"

# Existing LLM_API_KEY plus an LLM_BASE_URL of https://api.sarvam.ai/v1 or /v2
# continue to work, so an already-connected Sarvam app needs no secret changes.
