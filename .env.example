# Only needed for the optional AI judge. Export the one you use in your shell (the tool doesn't read .env files):
#   export GEMINI_API_KEY=...
# On Streamlit Community Cloud, put it under App settings > Secrets instead. Never commit a real key.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# For -m custom:<model>, an OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
# Seconds between AI calls (default 4 for Gemini's free tier, 2 for Groq)
PROMO_LLM_MIN_INTERVAL=
